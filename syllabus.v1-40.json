[
  {"id": "wa-desu",        "pattern": "〜は〜です",            "name": "X is Y (topic は + noun + です)",                "formula": "[Topic] は [Noun] です。"},
  {"id": "ka-question",    "pattern": "〜ですか",              "name": "Yes/no questions with か",                        "formula": "[Topic] は [Noun] ですか。"},
  {"id": "ja-nai-desu",    "pattern": "〜じゃないです",        "name": "X is not Y (noun negative)",                      "formula": "[Topic] は [Noun] じゃないです。"},
  {"id": "no-link",        "pattern": "〜の〜",                "name": "の links nouns (my, of, 's)",                     "formula": "[Noun A] の [Noun B]"},
  {"id": "kore-sore",      "pattern": "これ／それ／あれ・この〜", "name": "This / that / that over there",                   "formula": "これ は [Noun] です。 / この [Noun] は …"},
  {"id": "question-words", "pattern": "なん／どこ／だれ",      "name": "Question words slot in where the answer goes",    "formula": "[Topic] は なん ですか。"},
  {"id": "mo-also",        "pattern": "〜も",                  "name": "も = also / too (replaces は)",                   "formula": "[Topic] も [Noun] です。"},
  {"id": "i-adj-desu",     "pattern": "い-adjective + です",   "name": "い-adjectives as the predicate",                  "formula": "[Topic] は [い-adj] です。"},
  {"id": "i-adj-neg",      "pattern": "〜くないです",          "name": "い-adjective negative",                           "formula": "[Topic] は [い-adj stem] くないです。"},
  {"id": "na-adj-desu",    "pattern": "な-adjective + です",   "name": "な-adjectives (and their negative じゃないです)", "formula": "[Topic] は [な-adj] です／じゃないです。"},
  {"id": "adj-noun",       "pattern": "adjective + noun",      "name": "Adjectives in front of nouns (おいしい コーヒー / しずかな まち)", "formula": "[い-adj] [Noun] / [な-adj] な [Noun]"},
  {"id": "totemo-amari",   "pattern": "とても／あまり〜ない",   "name": "Degree: very / not very",                         "formula": "とても [adj] です。 / あまり [adj-negative] です。"},
  {"id": "ga-arimasu",     "pattern": "〜が あります／います",  "name": "There is / I have (things vs. living beings)",    "formula": "[Thing] が あります。 / [Person/animal] が います。"},
  {"id": "ni-location",    "pattern": "〜に〜が あります",      "name": "Location に + existence",                         "formula": "[Place] に [Thing] が あります。"},
  {"id": "wo-masu",        "pattern": "〜を V-ます",           "name": "Object を + verb (basic SOV order)",              "formula": "[Topic] は [Object] を [Verb]-ます。"},
  {"id": "masen",          "pattern": "V-ません",              "name": "Verb negative (polite)",                          "formula": "[Object] を [Verb]-ません。"},
  {"id": "ni-iku",         "pattern": "〜に 行きます",          "name": "Destination に + motion verbs (行く/来る/帰る)",   "formula": "[Place] に 行きます。"},
  {"id": "de-action",      "pattern": "〜で V-ます",           "name": "で = where an action happens",                    "formula": "[Place] で [Object] を [Verb]-ます。"},
  {"id": "time-ni",        "pattern": "time + に",             "name": "Time markers (7じ に, どようび に; きょう/あした need no に)", "formula": "[Time] に [Verb]-ます。"},
  {"id": "mashita",        "pattern": "V-ました／V-ませんでした", "name": "Verb past (did / didn't)",                       "formula": "きのう [Object] を [Verb]-ました。"},
  {"id": "adj-past",       "pattern": "〜かったです／〜でした", "name": "Adjective and noun past tense",                    "formula": "[い-adj stem] かったです。 / [な-adj/Noun] でした。"},
  {"id": "to-and-with",    "pattern": "〜と",                  "name": "と = and (between nouns) / with (a person)",      "formula": "[Noun] と [Noun] / [Person] と [Verb]-ます。"},
  {"id": "ga-suki",        "pattern": "〜が 好きです",          "name": "Likes and dislikes (が marks the thing liked)",   "formula": "[Topic] は [Thing] が 好きです／きらいです。"},
  {"id": "masenka",        "pattern": "V-ませんか／V-ましょう", "name": "Invitations and suggestions",                     "formula": "いっしょに [Verb]-ませんか。 / [Verb]-ましょう。"},
  {"id": "tai-desu",       "pattern": "V-たいです",            "name": "Want to do (verb stem + たい, acts like an い-adj)", "formula": "[Object] を／が [Verb stem] たいです。"},
  {"id": "ga-hoshii",      "pattern": "〜が ほしいです",        "name": "Want a thing",                                    "formula": "[Thing] が ほしいです。"},
  {"id": "kara-because",   "pattern": "〜から",                "name": "Reason から (because…, so…)",                     "formula": "[Reason] から、[Result]。"},
  {"id": "ga-but",         "pattern": "〜が、〜",              "name": "Joining two sentences with が (but)",             "formula": "[Sentence 1] が、[Sentence 2]。"},
  {"id": "kute-de",        "pattern": "〜くて／〜で",           "name": "Linking adjectives (cheap and tasty)",            "formula": "[い-adj stem] くて [adj] / [な-adj] で [adj]"},
  {"id": "te-kudasai",     "pattern": "V-て ください",         "name": "て-form intro: please do",                        "formula": "[Verb て-form] ください。"},
  {"id": "te-imasu",       "pattern": "V-て います",           "name": "Ongoing action / state (is doing)",               "formula": "いま [Verb て-form] います。"},
  {"id": "te-sequence",    "pattern": "V-て、V-ます",          "name": "Sequence of actions (do A, then B)",              "formula": "[Verb A て-form]、[Verb B]-ます。"},
  {"id": "naru",           "pattern": "〜く／に なります",      "name": "Become (さむく なります / げんきに なります)",      "formula": "[い-adj stem] く なります。 / [な-adj/Noun] に なります。"},
  {"id": "yori-hou",       "pattern": "〜より〜のほうが",       "name": "Comparison",                                      "formula": "[A] より [B] の ほうが [adj] です。"},
  {"id": "dictionary-form","pattern": "dictionary form + のが 好き", "name": "Plain (dictionary) form verbs, inside a bigger sentence", "formula": "[Verb dict. form] の が 好きです。"},
  {"id": "noun-clause",    "pattern": "clause + noun",         "name": "Describing nouns with whole clauses (the book I read)", "formula": "[Plain-form clause] [Noun]"},
  {"id": "to-omoimasu",    "pattern": "〜と 思います",          "name": "I think that… (plain form + と思います)",         "formula": "[Plain-form sentence] と 思います。"},
  {"id": "ta-koto-ga-aru", "pattern": "V-た ことが あります",   "name": "Plain past + have done before",                  "formula": "[Verb た-form] ことが あります。"},
  {"id": "toki",           "pattern": "〜とき",                "name": "When… (time clauses)",                            "formula": "[Plain-form clause] とき、[Sentence]。"},
  {"id": "plain-speech",   "pattern": "casual plain style",    "name": "Casual speech between friends (だ / plain verbs)", "formula": "[Sentence in plain form] (よ／ね)"}
]
