  "narration": {
    "pattern_romaji": "A no B",
    "pattern_jp": "AのB",
    "pattern_english": "A's B / the B of A",
    "slots": [
      {
        "slot": "A",
        "fits": "The owner or describer: a person (わたし, けん, ゆき, ともだち), a place (みせ, とうきょう), or a time (あした). It always comes first."
      },
      {
        "slot": "B",
        "fits": "The main thing you are talking about: an object, a person, or a place (コーヒー, ケーキ, メニュー, みせ, ともだち)."
      }
    ],
    "segments": [
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "Welcome back! Today's pattern is {AのB}. It means: A's B, or the B of A. The little word {の} links two nouns together."
      },
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "Here's the whole idea in one short phrase."
      },
      {
        "kind": "jp",
        "speaker": "A",
        "speed": "teaching",
        "text": "わたしのコーヒー"
      },
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "My coffee. Word for word, that's: me, link word, coffee. Me-'s coffee."
      },
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "Let's walk through the slots. Slot A is the owner, or whatever describes the thing: a person, a place, a group. Slot B is the main thing you're actually talking about."
      },
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "And {の} sits right between them, doing the job of apostrophe-s in English."
      },
      {
        "kind": "jp",
        "speaker": "B",
        "speed": "teaching",
        "text": "けんのケーキ"
      },
      {
        "kind": "en",
