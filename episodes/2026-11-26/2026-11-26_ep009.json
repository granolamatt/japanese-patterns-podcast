  "narration": {
    "pattern_romaji": "A wa B-kunai desu",
    "pattern_jp": "AはBくないです",
    "pattern_english": "A is not B",
    "slots": [
      {
        "slot": "A",
        "fits": "the topic: a thing, place, food or drink, often with この/その/あれ (このおにぎり, このコーヒー, 東京)"
      },
      {
        "slot": "B",
        "fits": "an い-adjective with its final い removed (たか-, あつ-, おいし-, つめた-). Exception: いい becomes よくない"
      }
    ],
    "segments": [
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "Welcome back! Today's pattern is {AはBくないです}. It means: A is not B, where B is a describing word, an adjective."
      },
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "Last time you learned adjectives that end in {い}, like {たかい}, expensive, and {あつい}, hot. Today we make them negative."
      },
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "Slot A is the topic, the thing you're talking about, followed by {は}. Slot B is the adjective, but with its final {い} taken off."
      },
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "Then you add {くない}, which means 'not', and finish with the polite {です}. As always, {です} comes last."
      },
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "English says 'is not expensive.' Japanese says, piece by piece, 'expensive, not, politely.' The 'not' is glued right onto the adjective."
      },
      {
        "kind": "en",
        "speaker": "A",
        "speed": "teaching",
        "text": "Let's build one. Start with the adjective."
